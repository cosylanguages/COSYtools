ve","prepositions":["to"],"pattern":"be + nice to + [someone]","level":"A1","definition":"Pleasant, polite, or agreeable toward someone.","grammar_rule":"Use 'nice to' for behavior toward someone. Use 'nice of' when evaluating an action (It was nice of you).","examples":["The staff at the hotel were very nice to us.","Always be nice to your classmates."],"common_mistake":"❌ Be nice with your sister. ➜ ✅ Be nice to your sister.","synonyms":["kind to","polite to","friendly to"],"antonyms":["rude to","nasty to","mean to"]}},{"lemma":"name of","kind":"nouns","source":"tools/en/verb-prep/data/nouns.json","data":{"word_type":"noun","prepositions":["of"],"pattern":"name of + [person / place / thing]","level":"A1","definition":"The word or words by which a person, place, or thing is known.","grammar_rule":"Always use 'of' after 'name' when identifying the entity.","examples":["What is the name of this beautiful street?","I cannot remember the name of that actor."],"common_mistake":"❌ What is the name for this city? ➜ ✅ What is the name of this city?","synonyms":["title of","designation of"],"antonyms":["anonymity","namelessness"]}},{"lemma":"need for","kind":"nouns","source":"tools/en/verb-prep/data/nouns.json","data":{"word_type":"noun","prepositions":["for"],"pattern":"need for + [noun / gerund (-ing)]","level":"A1","definition":"A requirement or necessity for something.","grammar_rule":"The noun 'need FOR' takes 'for'. Contrast with the transitive verb 'need' which takes a direct object with NO preposition.","examples":["There is an urgent need for healthcare reform.","We see no need for further delay."],"common_mistake":"❌ We have a need of more time. ➜ ✅ We have a need for more time.","synonyms":["demand for","requirement for","necessity for"],"antonyms":["abundance of","surplus of"],"related_forms":"⚡ Noun: 'there is a need FOR action' ➔ Verb: 'we need action' (no prep)"}},{"lemma":"need","kind":"verbs","source":"tools/en/verb-prep/data/verbs.json","data":{"is_phrasal":false,"transitivity":"Transitive","transitivity_code":"VT","prepositions":["none"],"pattern":"need [something / to do]","level":"A1","definition":"To require something essential.","grammar_rule":"Followed directly by noun or 'to' + infinitive.","noun_parallel":"","examples":["I need a glass of water.","We need to talk."],"common_mistake":"❌ I need to a glass of water. ➔ ✅ I need a glass of water.","synonyms":[],"antonyms":[],"preposition_structure":"none","particle_count":0}}]}