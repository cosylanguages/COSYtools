urce":"UniMorph","source_url":"https://github.com/unimorph/eng"},{"lemma":"oblivious to","kind":"adjectives","source":"tools/en/verb-prep/data/adjectives.json","data":{"word_type":"adjective","prepositions":["to","of"],"pattern":"be + oblivious to/of + [danger / surroundings / facts]","level":"B2","definition":"Not aware of or not concerned about what is happening around one.","grammar_rule":"Use 'oblivious to' (most common) or 'oblivious of'.","examples":["She walked down the street, oblivious to the heavy rain.","He was oblivious of the risks involved."],"common_mistake":"❌ He was oblivious about the danger. ➜ ✅ He was oblivious to the danger.","synonyms":["unaware of","ignorant of","heedless of"],"antonyms":["aware of","mindful of","conscious of"]}},{"lemma":"obsessed with","kind":"adjectives","source":"tools/en/verb-prep/data/adjectives.json","data":{"word_type":"adjective","prepositions":["with","by"],"pattern":"be + obsessed with/by + [someone / something]","level":"B1","definition":"Unable to stop thinking about something; preoccupied continuously.","grammar_rule":"Use 'obsessed with' (most common) or 'obsessed by'.","examples":["He is obsessed with collecting rare vintage records.","She became obsessed with fitness and nutrition."],"common_mistake":"❌ She is obsessed about fashion. ➜ ✅ She is obsessed with fashion.","synonyms":["preoccupied with","infatuated with","fixated on"],"antonyms":["indifferent to","unconcerned about"]}},{"lemma":"open to","kind":"adjectives","source":"tools/en/verb-prep/data/adjectives.json","data":{"word_type":"adjective","prepositions":["to"],"pattern":"be + open to + [ideas / suggestions / public]","level":"A1","definition":"Receptive to new ideas, or accessible to people.","grammar_rule":"Use 'open to' for receptivity or accessibility.","examples":["The manager is always open to new suggestions.","The museum is open to the public daily."],"common_mistake":"❌ We are open for new ideas. ➜ ✅ We are open to new ideas.","synonyms":["receptive to","accessible to"],"antonyms":["closed to","impervious to"]}},{"lemma":"optimistic about","kind":"adjectives","source":"tools/en/verb-prep/data/adjectives.json","data":{"word_type":"adjective","prepositions":["about"],"pattern":"be + optimistic about + [future / outcome]","level":"B1","definition":"Hopeful and confident about the future or the success of something.","grammar_rule":"Always use 'about' after 'optimistic'. Do NOT use 'for'.","examples":["Investors are optimistic about economic growth next quarter.","She remains optimistic about her recovery."],"common_mistake":"❌ We are optimistic for success. ➜ ✅ We are optimistic about success.","synonyms":["hopeful about","confident about","sanguine about"],"antonyms":["pessimistic about","gloomy about"]}},{"lemma":"objection to","kind":"nouns","source":"tools/en/verb-prep/data/nouns.json","data":{"word_type":"noun","prepositions":["to"],"pattern":"objection to + [proposal / plan]","level":"B1","definition":"An expression or feeling of disapproval or opposition.","grammar_rule":"Matches verb 'object to'. The 'to' is a preposition requiring a noun or gerund.","examples":["Does anyone have any objection to moving the meeting to Friday?","The lawyer raised an objection to the question."],"common_mistake":"❌ An objection for the idea. ➜ ✅ An objection to the idea.","synonyms":["opposition to","protest against","demurral at"],"antonyms":["approval of","support for"],"related_forms":"⚡ Noun: 'an objection TO the plan' ➔ Verb: 'object to'"}},{"lemma":"opinion of","kind":"nouns","source":"tools/en/verb-prep/data/nouns.json","data":{"word_type":"noun","prepositions":["of","on","about"],"pattern":"opinion of/on/about + [topic / person]","level":"B1","definition":"A view or judgment formed about something, not necessarily based on fact.","grammar_rule":"Use 'opinion OF' a person's character, and 'opinion ON/ABOUT' a controversial issue.","examples":["What is your honest opinion of his performance?","Public opinion 