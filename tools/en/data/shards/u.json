":["upper"]},{"form":"German","features":["Upper"]},{"form":"semi-continuous","features":["upper"]},{"form":"semicontinuous","features":["upper"]},{"form":"Voltaic","features":["Upper"]},{"form":"Voltan","features":["Upper"]}],"source":"UniMorph","source_url":"https://github.com/unimorph/eng"},{"lemma":"unaccustomed to","kind":"adjectives","source":"tools/en/verb-prep/data/adjectives.json","data":{"word_type":"adjective","prepositions":["to"],"pattern":"be + unaccustomed to + [noun / gerund (-ing)]","level":"B2","definition":"Not familiar with or used to something.","grammar_rule":"Follow 'unaccustomed to' with a gerund (-ing) or noun.","examples":["He was unaccustomed to speaking in front of large crowds.","She felt cold, unaccustomed to the harsh northern winter."],"common_mistake":"❌ He is unaccustomed to work late. ➜ ✅ He is unaccustomed to working late.","synonyms":["unfamiliar with","unused to","stranger to"],"antonyms":["accustomed to","used to","habituated to"]}},{"lemma":"unfit for","kind":"adjectives","source":"tools/en/verb-prep/data/adjectives.json","data":{"word_type":"adjective","prepositions":["for"],"pattern":"be + unfit for + [purpose / consumption / work]","level":"B2","definition":"Not suitable or suitable quality for a particular purpose.","grammar_rule":"Always use 'for' after 'unfit'.","examples":["The flood damaged water supply was rendered unfit for human consumption.","He was declared unfit for military service."],"common_mistake":"❌ The food is unfit to eat. ➜ ✅ The food is unfit for human consumption.","synonyms":["unsuitable for","inappropriate for","incapable of"],"antonyms":["fit for","suitable for"]}},{"lemma":"unmindful of","kind":"adjectives","source":"tools/en/verb-prep/data/adjectives.json","data":{"word_type":"adjective","prepositions":["of"],"pattern":"be + unmindful of + [danger / rules / consequences]","level":"B2","definition":"Not conscious or aware of something; heedless.","grammar_rule":"Always use 'of' after 'unmindful'.","examples":["They pressed forward, unmindful of the growing danger ahead.","He acted quickly, unmindful of personal safety."],"common_mistake":"❌ She was unmindful about the warnings. ➜ ✅ She was unmindful of the warnings.","synonyms":["oblivious to","heedless of","regardless of"],"antonyms":["mindful of","attentive to"]}},{"lemma":"upset about","kind":"adjectives","source":"tools/en/verb-prep/data/adjectives.json","data":{"word_type":"adjective","prepositions":["about","by","at"],"pattern":"be + upset about/by + [situation / news]","level":"A2","definition":"Unhappy, angry, or worried about something.","grammar_rule":"Use 'upset about' or 'upset by' for situations, news, or events.","examples":["She was deeply upset about losing her wedding ring.","Don't get upset by small misunderstandings."],"common_mistake":"❌ He is upset on his test grade. ➜ ✅ He is upset about his test grade.","synonyms":["distressed about","troubled by"],"antonyms":["calm about","unbothered by"]}},{"lemma":"useful for","kind":"adjectives","source":"tools/en/verb-prep/data/adjectives.json","data":{"word_type":"adjective","prepositions":["for","to"],"pattern":"be + useful for + [purpose / gerund (-ing)] / useful to + [someone]","level":"A2","definition":"Able to be used for a practical purpose or to help achieve something.","grammar_rule":"Use 'useful for' doing something (purpose), and 'useful to' a recipient.","examples":["This tool is very useful for repairing bicycles.","Your advice was extremely useful to us."],"common_mistake":"❌ It is useful to cleaning floors. ➜ ✅ It is useful for cleaning floors.","synonyms":["helpful for","handy for","beneficial to"],"antonyms":["useless for","unhelpful to"]}},{"lemma":"understanding of","kind":"nouns","source":"tools/en/verb-prep/data/nouns.json","data":{"word_type":"noun","prepositions":["of"],"pattern":"understanding of + [concept / subject / person]","level":"B1","definition":"The ability to understand something; comprehension.","grammar_rule":"Use 'understanding OF' a topic.","examples":["This textbook provides a clear understanding of economics.","We share a mutual understanding of the rules."],"common_mistake":"❌ Understanding for mathematics. ➜ ✅ Understanding of mathematics.","synonyms":["comprehension of","grasp of","insight into"],"antonyms":["misunderstanding of"]}},{"lemma":"undergo","kind":"verbs","source":"tools/en/irregular-verbs/data/verbs.json","data":{"base":"undergo","past_simple":"underwent","past_participle":"undergone","third_person_singular":"undergoes","pattern_group":"totally_irregular","level":"B1","definition":"To experience or endure process.","examples":["The patient undergoes treatment.","The building underwent major renovation.","The company has undergone changes."],"subgroup":"did_done_family","vowel_pattern":"u-u-u"}},{"lemma":"understand","kind":"verbs","source":"tools/en/irregular-verbs/data/verbs.json","data":{"base":"understand","past_simple":"understood","past_participle":"understood","third_person_singular":"understands","pattern_group":"same_past_participle","level":"A1","definition":"To perceive meaning or comprehend.","examples":["She understands complex ideas quickly.","He understood the instructions clearly.","They have understood the rules."],"subgroup":"base_past_past","vowel_pattern":"u-u-u"}},{"lemma":"undertake","kind":"verbs","source":"tools/en/irregular-verbs/data/verbs.json","data":{"base":"undertake","past_simple":"undertook","past_participle":"undertaken","third_person_singular":"undertakes","pattern_group":"add_en_or_n","level":"B2","definition":"To commit oneself to task.","examples":["Scientist undertakes complex study.","Company undertook major expansion.","We have undertaken new project."],"subgroup":"ablaut_plus_en","vowel_pattern":"u-u-u"}},{"lemma":"undo","kind":"verbs","source":"tools/en/irregular-verbs/data/verbs.json","data":{"base":"undo","past_simple":"undid","past_participle":"undone","third_person_singular":"undoes","pattern_group":"totally_irregular","level":"B1","definition":"To cancel or reverse action.","examples":["She undoes her hair braid.","He undid the knot with patience.","Damage cannot be easily undone."],"subgroup":"did_done_family","vowel_pattern":"u-u-u"}},{"lemma":"unwind","kind":"verbs","source":"tools/en/irregular-verbs/data/verbs.json","data":{"base":"unwind","past_simple":"unwound","past_participle":"unwound","third_person_singular":"unwinds","pattern_group":"vowel_change","level":"B1","definition":"To relax or uncoil string.","examples":["She unwinds by reading novels.","He unwound long garden hose pipe.","He has unwound after hard day."],"subgroup":"base_past_past","vowel_pattern":"u-u-u"}},{"lemma":"upset","kind":"verbs","source":"tools/en/irregular-verbs/data/verbs.json","data":{"base":"upset","past_simple":"upset","past_participle":"upset","third_person_singular":"upsets","pattern_group":"no_change","level":"B2","definition":"To disturb, distress, or overturn.","examples":["Bad news upsets her deeply.","Cat upset glass of water table.","Plans have been upset completely."],"subgroup":"no_change","vowel_pattern":"u-u-u"}}]}