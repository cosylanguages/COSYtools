":"adjectives","source":"tools/en/verb-prep/data/adjectives.json","data":{"word_type":"adjective","prepositions":["about","in"],"pattern":"be + wrong about + [topic / person]","level":"A1","definition":"Incorrect in one's judgment or belief regarding something.","grammar_rule":"Use 'wrong about' for topics or people. Use 'wrong in' when specifying an action (wrong in assuming).","examples":["I was completely wrong about the weather forecast today.","You were wrong about his motives."],"common_mistake":"❌ She was wrong on the timing. ➜ ✅ She was wrong about the timing.","synonyms":["mistaken about","incorrect about"],"antonyms":["right about","correct about"]}},{"lemma":"way to","kind":"nouns","source":"tools/en/verb-prep/data/nouns.json","data":{"word_type":"noun","prepositions":["to"],"pattern":"way to + [place / goal]","level":"A1","definition":"A method, style, or route for reaching a place or achieving an object.","grammar_rule":"Use 'way to' before destinations or goals.","examples":["Can you tell me the best way to the train station?","Hard work is the surest way to success."],"common_mistake":"❌ What is the way for the beach? ➜ ✅ What is the way to the beach?","synonyms":["route to","path to","method for"],"antonyms":["obstacle to","detour from"]}},{"lemma":"work of","kind":"nouns","source":"tools/en/verb-prep/data/nouns.json","data":{"word_type":"noun","prepositions":["of"],"pattern":"work of + [art / author / creator]","level":"A1","definition":"A literary or artistic creation, or labor by someone.","grammar_rule":"Use 'work of' when attributing artistic or creative origin.","examples":["Mona Lisa is a world-famous work of art.","This novel is the masterpiece work of Tolstoy."],"common_mistake":"❌ A work from Picasso. ➜ ✅ A work of Picasso.","synonyms":["creation of","masterpiece of"],"antonyms":["neglect by","destruction by"],"related_forms":"⚡ Noun: 'a work of art' ➔ Verb: 'work'"}},{"lemma":"wait for","kind":"verbs","source":"tools/en/verb-prep/data/verbs.json","data":{"is_phrasal":true,"separability":"Inseparable","particle":"for","transitivity":"Intransitive","transitivity_code":"VI","prepositions":["for"],"pattern":"wait for [someone / something]","level":"A1","definition":"To stay in a place until an expected person or event arrives.","grammar_rule":"Intransitive verb requiring 'for' when specifying the expected person or event.","examples":["I am waiting for the bus at the stop.","She waited for her friend for thirty minutes."],"common_mistake":"❌ I wait the bus. ➔ ✅ I wait for the bus.","synonyms":["await"],"antonyms":["leave","depart"],"preposition_structure":"single","particle_count":1}},{"lemma":"wake","kind":"verbs","source":"tools/en/irregular-verbs/data/verbs.json","data":{"base":"wake","past_simple":"woke","past_participle":"woken","third_person_singular":"wakes","pattern_group":"add_en_or_n","level":"A1","definition":"To emerge from sleep.","examples":["He wakes up early every morning.","She woke up at six today.","They have woken up refreshed."],"subgroup":"ablaut_plus_en","vowel_pattern":"a-o-o"}},{"lemma":"wake up","kind":"verbs","source":"tools/en/verb-prep/data/verbs.json","data":{"is_phrasal":true,"separability":"Inseparable","particle":"up","transitivity":"Intransitive","transitivity_code":"VI","prepositions":["at"],"pattern":"wake up (at [time])","level":"A1","definition":"To stop sleeping and become conscious.","grammar_rule":"Intransitive phrasal verb. Use 'at' when specifying exact time of waking.","examples":["I usually wake up at seven o'clock on weekdays.","She woke up early to catch the morning train."],"common_mistake":"❌ I wake up on 7 AM. ➔ ✅ I wake up at 7 AM.","synonyms":["awaken","get up"],"antonyms":["fall asleep","go to sleep"],"preposition_structure":"single","particle_count":1}},{"lemma":"walk out on","kind":"verbs","source":"tools/en/verb-prep/data/verbs.json","data":{"is_phrasal":true,"separability":"Inseparable","particle":"out on","transitivity":"Transitive","transitivity_code":"VT","prepositions":["on"],"pattern":"walk out on [partner / family / job]","level":"A2","definition":"To abandon or desert someone suddenly.","grammar_rule":"Inseparable multi-particle phrasal verb requiring 'on' before the abandoned party.","examples":["He walked out on his family without any explanation.","You cannot just walk out on your job mid-shift."],"common_mistake":"❌ He walked out from his team. ➔ ✅ He walked out on his team.","synonyms":["abandon","desert","leave"],"antonyms":["stand by","support"],"preposition_structure":"single","particle_count":2}},{"lemma":"want","kind":"verbs","source":"tools/en/verb-prep/data/verbs.json","data":{"is_phrasal":false,"transitivity":"Transitive","transitivity_code":"VT","prepositions":["none"],"pattern":"want [something / to do]","level":"A1","definition":"To feel a desire for something.","grammar_rule":"Followed by direct object or 'to' + infinitive.","noun_parallel":"","examples":["I want a new bicycle.","She wants to learn French."],"common_mistake":"❌ I want for a coffee. ➔ ✅ I want a coffee.","synonyms":[],"antonyms":[],"preposition_structure":"none","particle_count":0}},{"lemma":"warn","kind":"verbs","source":"tools/en/verb-prep/data/verbs.json","data":{"is_phrasal":false,"transitivity":"Transitive","transitivity_code":"VT","prepositions":["about","of","against"],"pattern":"warn [someone] about/of [danger]","level":"B1","definition":"To inform someone in advance of impending danger or trouble.","grammar_rule":"Direct transitive verb taking 'about' or 'of' before the hazard, or 'against' before an action.","noun_parallel":"⚡ Verb: 'Warn them about storm' ➔ Noun: 'Issue a warning ABOUT storm'","examples":["Scientists warned the public about the approaching storm.","She warned me against investing without research."],"common_mistake":"❌ They warned to us about the risk. ➔ ✅ They warned us about the risk.","synonyms":["caution about","alert to"],"antonyms":["reassure","encourage danger"],"preposition_structure":"dual","particle_count":1}},{"lemma":"wash","kind":"verbs","source":"tools/en/verb-prep/data/verbs.json","data":{"is_phrasal":false,"transitivity":"Prepositional","transitivity_code":"VI","prepositions":["with"],"pattern":"wash [hands/face] with [soap/water]","level":"A1","definition":"To clean with water/soap.","grammar_rule":"Direct transitive verb.","noun_parallel":"","examples":["Wash your hands before eating.","He washed with warm water."],"common_mistake":"❌ Wash hands by soap. ➔ ✅ Wash hands with soap.","synonyms":[],"antonyms":[],"preposition_structure":"single","particle_count":1}},{"lemma":"waylay","kind":"verbs","source":"tools/en/irregular-verbs/data/verbs.json","data":{"base":"waylay","past_simple":"waylaid","past_participle":"waylaid","third_person_singular":"waylays","pattern_group":"same_past_participle","level":"B2+","definition":"To ambush or intercept someone.","examples":["Bandits waylay travelers in forest.","Reporters waylaid minister at exit.","Delegates have been waylaid."],"subgroup":"base_past_past","vowel_pattern":"a-a-a"}},{"lemma":"wear","kind":"verbs","source":"tools/en/irregular-verbs/data/verbs.json","data":{"base":"wear","past_simple":"wore","past_participle":"worn","third_person_singular":"wears","pattern_group":"add_en_or_n","level":"A1","definition":"To have clothes or accessories on body.","examples":["She wears glasses for reading.","He wore a black suit to the wedding.","The coat has been worn out."],"subgroup":"ore_orn_family","vowel_pattern":"e-o-o"}},{"lemma":"weave","kind":"verbs","source":"tools/en/irregular-verbs/data/verbs.json","data":{"base":"weave","past_simple":"wove","past_participle":"woven","third_person_singular":"weaves","pattern_group":"add_en_or_n","level":"B2","definition":"To form fabric by interlacing.","examples":["Weaver weaves tapestry on loom.","She wove colorful carpet pattern.","Stories have been woven into myth."],"subgroup":"ablaut_plus_en","vowel_pattern":"e-o-o"}},{"lemma":"weep","kind":"verbs","source":"tools/en/irregular-verbs/data/verbs.json","data":{"base":"weep","past_simple":"wept","past_participle":"wept","third_person_singular":"weeps","pattern_group":"same_past_participle","level":"A2","definition":"To shed tears or cry deeply.","examples":["She weeps when watching sad movies.","He wept with relief upon hearing news.","They have wept for their loss."],"subgroup":"base_past_past","vowel_pattern":"e-e-e"}},{"lemma":"win","kind":"verbs","source":"tools/en/irregular-verbs/data/verbs.json","data":{"base":"win","past_simple":"won","past_participle":"won","third_person_singular":"wins","pattern_group":"vowel_change","level":"A1","definition":"To achieve victory in a contest.","examples":["He wins matches consistently.","She won first prize in the competition.","They have won three awards."],"subgroup":"base_past_past","vowel_pattern":"i-o-o"}},{"lemma":"withdraw","kind":"verbs","source":"tools/en/irregular-verbs/data/verbs.json","data":{"base":"withdraw","past_simple":"withdrew","past_participle":"withdrawn","third_person_singular":"withdraws","pattern_group":"add_en_or_n","level":"B1","definition":"To remove, take back, or retreat.","examples":["He withdraws cash from ATM machine.","Troops withdrew from border town.","She has withdrawn her candidacy."],"subgroup":"ew_awe_family","vowel_pattern":"i-i-i"}},{"lemma":"withhold","kind":"verbs","source":"tools/en/irregular-verbs/data/verbs.json","data":{"base":"withhold","past_simple":"withheld","past_participle":"withheld","third_person_singular":"withholds","pattern_group":"vowel_change","level":"B1","definition":"To refuse to give or hold back.","examples":["Company withhold tax from salary.","He withheld vital information court.","They have withheld payment details."],"subgroup":"base_past_past","vowel_pattern":"i-i-i"}},{"lemma":"withstand","kind":"verbs","source":"tools/en/irregular-verbs/data/verbs.json","data":{"base":"withstand","past_simple":"withstood","past_participle":"withstood","third_person_singular":"withstands","pattern_group":"same_past_participle","level":"B1","definition":"To resist or remain undamaged by.","examples":["The bridge withstands heavy storms.","Materials withstood extreme heat test.","The fortress has withstood attacks."],"subgroup":"base_past_past","vowel_pattern":"i-i-i"}},{"lemma":"work","kind":"verbs","source":"tools/en/verb-prep/data/verbs.json","data":{"is_phrasal":false,"transitivity":"Intransitive","transitivity_code":"VI","prepositions":["for","at","in"],"pattern":"work for [company] / work at [location] / work in [field]","level":"A1","definition":"To be engaged in physical or mental activity as a job.","grammar_rule":"Use 'work for' before an employer, 'work at' before a building, and 'work in' before an industry.","examples":["She works for a multinational IT company.","He works in education as a teacher."],"common_mistake":"❌ I work to Google. ➔ ✅ I work for Google.","synonyms":["be employed by","labor"],"antonyms":["be unemployed","retire"],"preposition_structure":"dual","particle_count":1}},{"lemma":"work on","kind":"verbs","source":"tools/en/verb-prep/data/verbs.json","data":{"is_phrasal":true,"transitivity":"Prepositional","transitivity_code":"VI","prepositions":["on","for"],"pattern":"work on [project] / work for [company]","level":"A1","definition":"To engage in labor or effort.","grammar_rule":"Requires on for projects and for for employers.","noun_parallel":"","examples":["I am working on a new project.","She works for a company."],"common_mistake":"❌ Work in a project. ➔ ✅ Work on a project.","synonyms":[],"antonyms":[],"preposition_structure":"dual","particle_count":2}},{"lemma":"work out","kind":"verbs","source":"tools/en/verb-prep/data/verbs.json","data":{"is_phrasal":true,"separability":"Separable","particle":"out","transitivity":"Both","transitivity_code":"Both","prepositions":["out"],"pattern":"work out (exercise - VI) / work out [a plan] (VT separable)","level":"A2","definition":"To exercise physically (VI), or calculate/solve a problem (VT separable).","grammar_rule":"Intransitive for physical fitness. Separable transitive when solving/calculating ('work it out').","examples":["I work out at the gym three times a week.","We need to work out a strategy before launching.","The math problem was tough, but he worked it out."],"common_mistake":"❌ Work out it carefully. ➔ ✅ Work it out carefully.","synonyms":["exercise","calculate","resolve"],"antonyms":["fail","go wrong"],"preposition_structure":"single","particle_count":1}},{"lemma":"work with","kind":"verbs","source":"tools/en/verb-prep/data/verbs.json","data":{"is_phrasal":true,"separability":"Inseparable","particle":"with / on","transitivity":"Both","transitivity_code":"Both","prepositions":["with","on"],"pattern":"work with [someone] on [something/project]","level":"A2","definition":"To collaborate or cooperate with a team or client on a specific project or objective.","grammar_rule":"Multi-preposition structure: work WITH + person/team/company ON + project/task. Note: FOR + noun/gerund expresses purpose, whereas TO + verb infinitive expresses intention.","noun_parallel":"⚡ Verb: 'work with a team on a project' ➔ Noun: 'collaboration WITH someone ON something'","examples":["He works closely with his team to execute marketing campaigns.","She works with small businesses on social media strategy."],"common_mistake":"❌ Work to a team for a project. ➔ ✅ Work with a team on a project.","synonyms":["collaborate with","cooperate with"],"antonyms":["work against","oppose"],"preposition_structure":"dual","particle_count":1}},{"lemma":"worry","kind":"verbs","source":"tools/en/verb-prep/data/verbs.json","data":{"is_phrasal":false,"transitivity":"Both","transitivity_code":"Both","prepositions":["about"],"pattern":"worry about [someone / something]","level":"A2","definition":"To feel anxious or uneasy about actual or potential problems.","grammar_rule":"Intransitive uses 'about'. Passive / state form: 'be worried ABOUT'.","examples":["Don't worry about the future.","Parents always worry about their children."],"common_mistake":"❌ Don't worry for this. ➔ ✅ Don't worry about this.","synonyms":["fret","be anxious"],"antonyms":["reassure","calm"],"preposition_structure":"single","particle_count":1}},{"lemma":"wring","kind":"verbs","source":"tools/en/irregular-verbs/data/verbs.json","data":{"base":"wring","past_simple":"wrung","past_participle":"wrung","third_person_singular":"wrings","pattern_group":"vowel_change","level":"B2+","definition":"To extract money or truth by force.","examples":["Interrogator wrings confession from suspect.","He wrung promise from reluctant partner.","Truth was wrung from him."],"subgroup":"base_past_past","vowel_pattern":"i-u-u"}},{"lemma":"write","kind":"verbs","source":"tools/en/irregular-verbs/data/verbs.json","data":{"base":"write","past_simple":"wrote","past_participle":"written","third_person_singular":"writes","pattern_group":"add_en_or_n","level":"A1","definition":"To form letters or words on a surface.","examples":["She writes articles for a magazine.","He wrote a long letter yesterday.","I have written three chapters so far."],"subgroup":"ablaut_plus_en","vowel_pattern":"i-o-i"}},{"lemma":"write to","kind":"verbs","source":"tools/en/verb-prep/data/verbs.json","data":{"is_phrasal":true,"separability":"Inseparable","particle":"to","transitivity":"Intransitive","transitivity_code":"VI","prepositions":["to"],"pattern":"write to [person]","level":"A2","definition":"To send a letter or written communication to someone.","grammar_rule":"Intransitive in British/Standard English requiring 'to' before the recipient.","noun_parallel":"⚡ Verb: 'Write to customer service' ➔ Noun: 'A letter TO customer service'","examples":["She wrote to her grandmother every month.","You should write to the council about this road issue."],"common_mistake":"❌ Write me a letter tomorrow. ➔ ✅ Write to me tomorrow.","synonyms":["correspond with","send a letter to"],"antonyms":["ignore","stop correspondence with"],"preposition_structure":"single","particle_count":1}}]}