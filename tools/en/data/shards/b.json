of"]}},{"lemma":"bored with","kind":"adjectives","source":"tools/en/verb-prep/data/adjectives.json","data":{"word_type":"adjective","prepositions":["with","of","by"],"pattern":"be + bored with/of + [something / gerund (-ing)]","level":"A1","definition":"Feeling weary and restless through lack of interest.","grammar_rule":"'Bored with' and 'bored by' are traditional standard forms; 'bored of' is extremely common in modern informal speech.","examples":["The students were bored with the repetitive lecture.","I am getting bored of watching TV."],"common_mistake":"❌ He is bored from his job. ➜ ✅ He is bored with his job.","synonyms":["tired of","weary of","fed up with"],"antonyms":["interested in","fascinated by","excited about"]}},{"lemma":"busy with","kind":"adjectives","source":"tools/en/verb-prep/data/adjectives.json","data":{"word_type":"adjective","prepositions":["with"],"pattern":"be + busy with + [task / work]","level":"A1","definition":"Occupied with an activity or task.","grammar_rule":"Use 'busy with' before nouns. Use 'busy' directly before gerunds (busy preparing).","examples":["She is busy with her homework right now.","They are busy with preparations for the conference."],"common_mistake":"❌ He is busy in his project. ➜ ✅ He is busy with his project.","synonyms":["occupied with","engaged in","swamped with"],"antonyms":["free from","idle"]}},{"lemma":"ban on","kind":"nouns","source":"tools/en/verb-prep/data/nouns.json","data":{"word_type":"noun","prepositions":["on"],"pattern":"ban on + [item / action / product]","level":"B1","definition":"An official or legal prohibition.","grammar_rule":"Always use 'BAN ON' when specifying prohibited items or activities.","examples":["The city announced a complete ban on single-use plastic bags.","There is a strict ban on parking along this street."],"common_mistake":"❌ A ban for firearms. ➜ ✅ A ban on firearms.","synonyms":["prohibition of","embargo on","veto on"],"antonyms":["permission for","allowance of"],"related_forms":"⚡ Noun: 'a ban ON smoking' ➔ Verb: 'ban'"}},{"lemma":"belief in","kind":"nouns","source":"tools/en/verb-prep/data/nouns.json","data":{"word_type":"noun","prepositions":["in"],"pattern":"belief in + [god / principles / human nature]","level":"A2","definition":"An acceptance that something exists or is true, especially without proof.","grammar_rule":"Both the noun 'belief IN' and verb 'believe in' take 'in'.","examples":["Her strong belief in justice guided her career.","He maintained a firm belief in his team's potential."],"common_mistake":"❌ Belief on magic is common in fairy tales. ➜ ✅ Belief in magic is common in fairy tales.","synonyms":["faith in","trust in","conviction in"],"antonyms":["disbelief in","skepticism about"],"related_forms":"⚡ Noun: 'belief IN equality' ➔ Verb: 'believe in'"}},{"lemma":"benefit of","kind":"nouns","source":"tools/en/verb-prep/data/nouns.json","data":{"word_type":"noun","prepositions":["of","from"],"pattern":"benefit of + [action / system] / benefit from + [program]","level":"A2","definition":"An advantage or profit gained from something.","grammar_rule":"Use 'benefit OF' when listing an intrinsic advantage. Contrast with verb 'benefit from'.","examples":["What are the health benefits of eating vegetables?","One benefit of remote work is saving commute time."],"common_mistake":"❌ The benefit for drinking water. ➜ ✅ The benefit of drinking water.","synonyms":["advantage of","perk of","utility of"],"antonyms":["drawback of","disadvantage of"],"related_forms":"⚡ Noun: 'the benefit OF exercise' ➔ Verb: 'benefit from'"}},{"lemma":"back up","kind":"verbs","source":"tools/en/verb-prep/data/verbs.json","data":{"is_phrasal":true,"separability":"Separable","particle":"up","transitivity":"Transitive","transitivity_code":"VT","prepositions":["up"],"pattern":"back up [data/person] / back [it] up","level":"B1","definition":"To make a copy of computer files, or support a person/claim.","grammar_rule":"Separable phrasal verb. 'Back it up' requires pronoun in middle.","examples":["Always back up your important documents to the cloud.","My colleagues backed me up during the board meeting."],"common_mistake":"❌ Back up it. ➔ ✅ Back it up.","synonyms":["support","duplicate","corroborate"],"antonyms":["undermine","delete"],"preposition_structure":"single","particle_count":1}},{"lemma":"be","kind":"verbs","source":"tools/en/irregular-verbs/data/verbs.json","data":{"base":"be","past_simple":"was/were","past_participle":"been","third_person_singular":"is","pattern_group":"totally_irregular","level":"A1","definition":"To exist or live.","examples":["She is a doctor at the city hospital.","They were happy with the results.","He has been to London twice."],"subgroup":"totally_irregular","vowel_pattern":"e-a-e"}},{"lemma":"bear","kind":"verbs","source":"tools/en/irregular-verbs/data/verbs.json","data":{"base":"bear","past_simple":"bore","past_participle":"borne","third_person_singular":"bears","pattern_group":"add_en_or_n","level":"B1","definition":"To carry, endure, or give birth to.","examples":["She bears the responsibility bravely.","He bore the pain without complaining.","She has borne three children."],"subgroup":"ore_orne","vowel_pattern":"e-o-o"}},{"lemma":"become","kind":"verbs","source":"tools/en/irregular-verbs/data/verbs.json","data":{"base":"become","past_simple":"became","past_participle":"become","third_person_singular":"becomes","pattern_group":"vowel_change","level":"A2","definition":"To begin to be or turn into something.","examples":["He becomes angry when plans change.","She became a lawyer last year.","It has become very cold outside."],"subgroup":"a_ou_a_come_family","vowel_pattern":"e-e-e"}},{"lemma":"befall","kind":"verbs","source":"tools/en/irregular-verbs/data/verbs.json","data":{"base":"befall","past_simple":"befell","past_participle":"befallen","third_person_singular":"befalls","pattern_group":"add_en_or_n","level":"B2","definition":"To happen to or occur to someone.","examples":["Tragedy befalls unaware travelers.","Misfortune befell the expedition team.","Great luck has befallen them."],"subgroup":"ablaut_plus_en","vowel_pattern":"e-e-e"}},{"lemma":"begin","kind":"verbs","source":"tools/en/irregular-verbs/data/verbs.json","data":{"base":"begin","past_simple":"began","past_participle":"begun","third_person_singular":"begins","pattern_group":"vowel_change","level":"A1","definition":"To start or initiate an action.","examples":["The class begins at nine o'clock every morning.","It began to rain heavily an hour ago.","We have begun our new project."],"subgroup":"i_a_u_ablaut","vowel_pattern":"e-e-e"}},{"lemma":"believe","kind":"verbs","source":"tools/en/verb-prep/data/verbs.json","data":{"is_phrasal":false,"transitivity":"Both","transitivity_code":"Both","prepositions":["in"],"pattern":"believe [someone / statement] (VT) / believe in [god / concept / oneself] (VI)","level":"A1","definition":"To accept something as true, or have faith/trust in something.","grammar_rule":"Transitive direct 'believe someone' = trust their words. Intransitive 'believe IN someone' = trust their character/existence.","examples":["Do you believe in magic?","I believe every word she said.","Always believe in yourself."],"common_mistake":"❌ I believe in what you said. ➔ ✅ I believe what you said.","synonyms":["trust","credit"],"antonyms":["doubt","disbelieve"],"preposition_structure":"single","particle_count":1}},{"lemma":"believe in","kind":"verbs","source":"tools/en/verb-prep/data/verbs.json","data":{"is_phrasal":true,"separability":"Inseparable","particle":"in","transitivity":"Intransitive","transitivity_code":"VI","prepositions":["in"],"pattern":"believe in [principle / ghost / ability]","level":"A1","definition":"To feel confident in the truth, existence, or value of something.","grammar_rule":"Requires 'in' when expressing faith in existence or confidence in abilities.","noun_parallel":"⚡ Verb: 'Believe in success' ➔ Noun: 'Have belief IN success'","examples":["Do you believe in ghosts?","I believe in your ability to succeed."],"common_mistake":"❌ I believe on honesty. ➔ ✅ I believe in honesty.","synonyms":["trust in","have faith in"],"antonyms":["doubt","disbelieve in"],"preposition_structure":"single","particle_count":1}},{"lemma":"belong in","kind":"verbs","source":"tools/en/verb-prep/data/verbs.json","data":{"is_phrasal":true,"separability":"Inseparable","particle":"in","transitivity":"Intransitive","transitivity_code":"VI","prepositions":["in","on"],"pattern":"belong in [place / category] / belong on [shelf]","level":"A2","definition":"To be properly classified or located in a specific place.","grammar_rule":"Intransitive positional phrasal verb taking 'in' for containers/rooms and 'on' for surfaces.","examples":["These dirty dishes belong in the dishwasher.","That painting belongs on the main wall."],"common_mistake":"❌ This book belongs at the shelf. ➔ ✅ This book belongs on the shelf.","synonyms":["fit in","go in"],"antonyms":["be out of place in","mismatch"],"preposition_structure":"dual","particle_count":1}},{"lemma":"belong to","kind":"verbs","source":"tools/en/verb-prep/data/verbs.json","data":{"is_phrasal":true,"separability":"Inseparable","particle":"to","transitivity":"Transitive","transitivity_code":"VT","prepositions":["to"],"pattern":"belong to [owner / group / organization]","level":"A1","definition":"To be owned by someone, or be a member of a group.","grammar_rule":"Requires 'to' before the owner or club/organization.","examples":["This laptop belongs to the IT department.","Does this notebook belong to you?"],"common_mistake":"❌ This belongs me. ➔ ✅ This belongs to me.","synonyms":["be owned by","pertain to"],"antonyms":["be separate from","be excluded from"],"preposition_structure":"single","particle_count":1}},{"lemma":"bend","kind":"verbs","source":"tools/en/irregular-verbs/data/verbs.json","data":{"base":"bend","past_simple":"bent","past_participle":"bent","third_person_singular":"bends","pattern_group":"sa