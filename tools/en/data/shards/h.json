ransitive","transitivity_code":"VT","prepositions":["none"],"pattern":"hate [someone / something]","level":"A1","definition":"To feel intense dislike.","grammar_rule":"Direct transitive verb without preposition.","noun_parallel":"","examples":["I hate getting up early.","He hates traffic jams."],"common_mistake":"❌ I hate to early mornings. ➔ ✅ I hate early mornings.","synonyms":[],"antonyms":[],"preposition_structure":"none","particle_count":0}},{"lemma":"have","kind":"verbs","source":"tools/en/irregular-verbs/data/verbs.json","data":{"base":"have","past_simple":"had","past_participle":"had","third_person_singular":"has","pattern_group":"totally_irregular","level":"A1","definition":"To possess or hold.","examples":["She has two brothers and one sister.","He had a cold last week.","They have had a wonderful holiday."],"subgroup":"base_past_past","vowel_pattern":"a-a-a"}},{"lemma":"hear","kind":"verbs","source":"tools/en/irregular-verbs/data/verbs.json","data":{"base":"hear","past_simple":"heard","past_participle":"heard","third_person_singular":"hears","pattern_group":"same_past_participle","level":"A1","definition":"To perceive sound with the ear.","examples":["She hears music coming from next door.","He heard a loud noise last night.","We have heard the news already."],"subgroup":"base_past_past","vowel_pattern":"e-e-e"}},{"lemma":"hew","kind":"verbs","source":"tools/en/irregular-verbs/data/verbs.json","data":{"base":"hew","past_simple":"hewed","past_participle":"hewn","third_person_singular":"hews","pattern_group":"add_en_or_n","level":"B2","definition":"To chop or cut with axe.","examples":["Lumberjacks hew timber in forest.","He hewed statue from granite block.","Columns were hewn from marble quarry."],"subgroup":"regular_past_n_participle","vowel_pattern":"e-e-e"}},{"lemma":"hide","kind":"verbs","source":"tools/en/irregular-verbs/data/verbs.json","data":{"base":"hide","past_simple":"hid","past_participle":"hidden","third_person_singular":"hides","pattern_group