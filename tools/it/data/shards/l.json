ions":["a"],"pattern":"limitato + a + [campo/ambito]","level":"B2","definition":"Contenuto ed entro un raggio circoscritto di applicazione.","grammar_rule":"Richiede la preposizione « a » con relative articolazioni.","related_forms":"⚡ Aggettivo: 'limitato a' ➜ Verbo correlato: 'astenersi' / Nome correlato: 'freno a'","examples":["L'accesso alla sala è limitato al personale autorizzato.","Un danno limitato a poche componenti dell'auto."],"common_mistake":"❌ Un uso limitato di la città di Roma. ➜ ✅ Un uso limitato alla città di Roma.","synonyms":["circoscritto a","ristretto a"],"antonyms":["illimitato a","esteso a"]}},{"lemma":"lontano da","kind":"adjectives","source":"tools/it/reggenza/data/adjectives.json","data":{"word_type":"adjective","prepositions":["da"],"pattern":"lontano + da + [luogo/persona]","level":"A1","definition":"Che si trova a grande distanza da un punto.","grammar_rule":"Richiede la preposizione « da » con relative preposizioni articolate (lontano dal centro, dalla città).","related_forms":"⚡ Aggettivo: 'lontano da' ➜ Verbo correlato: 'partire' / Nome correlato: 'distacco da'","examples":["La sua casa è lontana dal centro abitato.","Non vivere troppo lontano dalla famiglia."],"common_mistake":"❌ Abita lontano di Milano. ➜ ✅ Abita lontano da Milano.","synonyms":["distante da","rimoto da"],"antonyms":["vicino a","accanto a"]}},{"lemma":"lago","kind":"nouns","source":"tools/it/genere/data/nouns.json","data":{"gender":"Maschile","level":"A1","definition":"Bacino d'acqua dolce.","antonyms":[],"article":"il","plural":"laghi","irregular":false,"indefinite_article":"un"}},{"lemma":"lampada","kind":"nouns","source":"tools/it/genere/data/nouns.json","data":{"gender":"Femminile","level":"A1","definition":"Apparecchio per produrre luce artificiale in una stanza.","antonyms":[],"article":"la","plural":"lampade","irregular":false,"indefinite_article":"una"}},{"lemma":"latte","kind":"nouns","source":"tools/it/genere/data/nouns.json","data":{"gender":"Maschile","l